      "net.pitan76.nexton.core.fabric.NextonCoreFabric"
    ],
    "client": [
      "net.pitan76.nexton.core.fabric.NextonCoreClientFabric"
    ]
  },
  "depends": {
    "fabricloader": "*",
    "minecraft": "*",
    "mcpitanlib": ">3.6.7"
